{
  "name": "osce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy --config dist/osce/wrangler.json",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-document": "^3.33.0",
    "@tiptap/extension-heading": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.0",
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
