{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name of the project you connected in the Cloudflare dashboard.
  "name": "osce",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Directory is supplied by @cloudflare/vite-plugin at build time.
    "not_found_handling": "single-page-application",
    // WebSocket and API requests must reach the Worker, not the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Workers Rate Limiting binding: blunts room-code enumeration by display joins.
  "ratelimits": [
    {
      "name": "JOIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
